languagesystem DFLT dflt;
languagesystem latn dflt;

feature calt {
  sub uni002D uni003E by arrowRight;
  sub uni003D uni003E by doubleArrowRight;
  sub uni0021 uni003D by notEqual;
  sub uni003C uni003D by lessEqual;
  sub uni003E uni003D by greaterEqual;
  sub uni003D uni003D by doubleEqual;
} calt;
