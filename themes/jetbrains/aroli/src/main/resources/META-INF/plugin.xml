<idea-plugin>
  <id>aroli.jetbrains.theme</id>
  <name>Aroli Themes</name>
  <version>0.2.0</version>
  <vendor url="https://github.com/eduardoaugustolb/aroli">Aroli</vendor>
  <description><![CDATA[
    <p>Aroli Dark for JetBrains IDEs.</p>
    <p>Quiet surfaces and controlled semantic color for focused work.</p>
  ]]></description>

  <idea-version since-build="241"/>
  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <themeProvider id="6c266d3e-20a4-4a75-8f84-3e4a7c8a4501" path="/Aroli.theme.json"/>
    <bundledColorScheme id="Aroli" path="/Aroli.xml"/>
  </extensions>
</idea-plugin>
